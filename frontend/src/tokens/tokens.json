{
  "$schema": "https://tokens.studio/schemas/token-set.json",
  "global": {
    "color": {
      "gold": {
        "value": "#fdb518",
        "type": "color",
        "description": "Primary gold accent fill for shop1 (luxury pastries & sweets)"
      },
      "goldText": {
        "value": "#92400e",
        "type": "color",
        "description": "WCAG AA high-contrast amber-gold text for light/cream surfaces (>= 6.9:1)"
      },
      "espresso": {
        "value": "#0c0603",
        "type": "color",
        "description": "High-contrast dark espresso foreground on gold fills (>= 11:1)"
      },
      "blue": {
        "value": "#1e3a5f",
        "type": "color",
        "description": "Deep navy accent for shop2 (dry pastries & Nawashef)"
      },
      "dangerBadge": {
        "value": "#dc2626",
        "type": "color",
        "description": "WCAG AA accessible notification badge red with white foreground (4.83:1)"
      },
      "slate": {
        "950": { "value": "#020617", "type": "color" },
        "900": { "value": "#0f172a", "type": "color", "description": "Dark foundation for card image wrappers" },
        "800": { "value": "#1e293b", "type": "color" },
        "700": { "value": "#334155", "type": "color" },
        "600": { "value": "#475569", "type": "color" }
      },
      "warm": {
        "bg": { "value": "#f7f3ec", "type": "color", "description": "Global warm backdrop" },
        "card": { "value": "#fffdf9", "type": "color", "description": "Card surface color" },
        "text": { "value": "#2c2520", "type": "color", "description": "High-contrast text color" },
        "muted": { "value": "#685f58", "type": "color", "description": "WCAG AA accessible secondary text color (>= 5.4:1)" }
      }
    },
    "spacing": {
      "xs": { "value": "4px", "type": "spacing" },
      "sm": { "value": "8px", "type": "spacing" },
      "md": { "value": "16px", "type": "spacing" },
      "lg": { "value": "24px", "type": "spacing" },
      "xl": { "value": "32px", "type": "spacing" },
      "2xl": { "value": "48px", "type": "spacing" }
    },
    "borderRadius": {
      "sm": { "value": "6px", "type": "borderRadius" },
      "md": { "value": "10px", "type": "borderRadius" },
      "lg": { "value": "16px", "type": "borderRadius" },
      "xl": { "value": "20px", "type": "borderRadius" },
      "pill": { "value": "9999px", "type": "borderRadius" }
    },
    "typography": {
      "fontFamily": {
        "value": "'Cairo', sans-serif",
        "type": "fontFamilies",
        "description": "Arabic brand typeface with generous vertical metrics"
      },
      "fontSize": {
        "xs": { "value": "0.75rem", "type": "fontSizes" },
        "sm": { "value": "0.875rem", "type": "fontSizes" },
        "base": { "value": "1rem", "type": "fontSizes" },
        "lg": { "value": "1.125rem", "type": "fontSizes" },
        "xl": { "value": "1.25rem", "type": "fontSizes" },
        "2xl": { "value": "1.5rem", "type": "fontSizes" },
        "inputMobile": { "value": "16px", "type": "fontSizes", "description": "Strict iOS Safari auto-zoom guard" }
      },
      "lineHeight": {
        "tight": { "value": "1.25", "type": "lineHeights" },
        "normal": { "value": "1.5", "type": "lineHeights" },
        "relaxed": { "value": "1.65", "type": "lineHeights" }
      }
    },
    "boxShadow": {
      "sm": { "value": "0 1px 3px rgba(44, 37, 32, 0.04), 0 1px 2px rgba(44, 37, 32, 0.03)", "type": "boxShadow" },
      "md": { "value": "0 4px 12px rgba(44, 37, 32, 0.06), 0 1px 4px rgba(44, 37, 32, 0.04)", "type": "boxShadow" },
      "lg": { "value": "0 8px 24px rgba(44, 37, 32, 0.08), 0 2px 8px rgba(44, 37, 32, 0.04)", "type": "boxShadow" },
      "xl": { "value": "0 16px 40px rgba(44, 37, 32, 0.1), 0 4px 12px rgba(44, 37, 32, 0.05)", "type": "boxShadow" }
    },
    "touchTarget": {
      "min": { "value": "48px", "type": "dimension", "description": "Minimum accessible touch target (WCAG/Android/iOS)" },
      "clearance": { "value": "8px", "type": "dimension", "description": "Minimum clearance between interactive touch targets" }
    }
  },
  "semantic": {
    "shop1": {
      "primary": { "value": "{global.color.gold.value}", "type": "color" },
      "textStrong": { "value": "{global.color.goldText.value}", "type": "color" },
      "onPrimary": { "value": "{global.color.espresso.value}", "type": "color" },
      "glow": { "value": "rgba(253, 181, 24, 0.15)", "type": "color" }
    },
    "shop2": {
      "primary": { "value": "{global.color.blue.value}", "type": "color" },
      "textStrong": { "value": "{global.color.blue.value}", "type": "color" },
      "onPrimary": { "value": "#ffffff", "type": "color" },
      "glow": { "value": "rgba(30, 58, 95, 0.15)", "type": "color" }
    }
  },
  "component": {
    "productCard": {
      "aspectRatio": { "value": "4 / 3", "type": "other" },
      "radius": { "value": "{global.borderRadius.lg.value}", "type": "borderRadius" },
      "imageBg": { "value": "{global.color.slate.900.value}", "type": "color" }
    },
    "bottomSheet": {
      "handleWidth": { "value": "40px", "type": "dimension" },
      "handleHeight": { "value": "4px", "type": "dimension" },
      "radius": { "value": "{global.borderRadius.xl.value}", "type": "borderRadius" }
    }
  }
}
