# MongoDB Configuration (required at runtime)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Server Runtime & Environment
NODE_ENV=development
PORT=3000

# Admin & Staff Security
ADMIN_USER=admin
ADMIN_PASS=change_this_strong_password
ADMIN_SESSION_SECRET=change_this_to_a_long_random_secret_string
BULK_CODE=change_this_bulk_access_code
PUBLIC_STAFF_SELECTOR=true

# Token & Security Enforcement
CUSTOMER_TOKEN_TTL_DAYS=30
STRICT_CONFIG=false
ENABLE_DEBUG_ROUTES=false

# AWS S3 & CloudFront Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=e-menu-products
AWS_CLOUDFRONT_DOMAIN=

# PocketBase Inventory Sync Integration
POCKETBASE_URL=https://crystal-crocodile.pikapod.net

# Local Backups Directory (optional; defaults to ~/Documents/EmenuBackup)
BACKUP_DIR=
